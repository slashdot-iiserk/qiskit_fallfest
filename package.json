{
  "name": "qiskit-fallfest-iiserk",
  "version": "2026.1.0",
  "private": true,
  "description": "Website for the Qiskit Fall Fest at IISER Kolkata, maintained by SlashDot.",
  "type": "module",
  "scripts": {
    "serve": "python3 -m http.server 4173 --bind 127.0.0.1",
    "build": "python3 tools/build_assets.py && npm run build:pages",
    "build:pages": "cd tools && python3 build_index.py && python3 build_pages.py",
    "build:assets": "python3 tools/build_assets.py",
    "test": "node --test tests/unit/*.test.js && playwright test",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "build:model": "./tools/build_model.sh"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.0",
    "@playwright/test": "^1.49.0",
    "animejs": "^4.5.0",
    "three": "^0.185.1"
  },
  "engines": {
    "node": ">=20"
  }
}
